# 原生二進位可指定絕對路徑；留白時使用 npm 隨附的原生 FFmpeg / ffprobe。
# 建議正式環境使用系統更新的完整版本；Docker 已設定 /usr/bin 路徑。
FFMPEG_PATH=
FFPROBE_PATH=
PORT=3000
MAX_UPLOAD_MB=200
MAX_CONCURRENT_JOBS=2
RENDER_TIMEOUT_MS=180000
REQUEST_TIMEOUT_MS=240000
MEDIA_TTL_MS=1800000
MEDIA_TEMP_DIR=.media-cache
RATE_LIMIT_MAX=20
# 公網部署填入網站的完整 origin，例如 https://meme.example.com
APP_ORIGIN=
# 只有反向代理會覆寫 X-Forwarded-For，且 Node 不可被直接存取時才能設 1。
TRUST_PROXY=0

# 一般 Node 預設磁碟暫存；Vercel 自動使用 blob 與 /tmp。
MEDIA_STORAGE=disk
# Vercel 連接 Private Blob 後自動提供，優先使用平台 OIDC。
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
# 僅本機 Blob 測試需要；不要提交實際憑證。
BLOB_READ_WRITE_TOKEN=
# Vercel Cron 使用的隨機密鑰（部署時設定，不可放進 Git）。
CRON_SECRET=
