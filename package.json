{
  "name": "iphone-duo-green-screen-tool",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "format": "prettier --write src scripts tests e2e *.ts *.mjs *.json README.md docs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "template:prepare": "tsx scripts/prepare-template.ts",
    "brand:prepare": "node scripts/prepare-brand.mjs",
    "test:fixtures": "tsx scripts/create-fixtures.ts",
    "verify:video": "tsx scripts/verify-video.ts"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^1.44.0",
    "next": "16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/busboy": "^1.5.4",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "next-rspack": "16.3.4",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
